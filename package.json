{
  "name": "browser-media-recorder",
  "version": "0.3.0",
  "private": true,
  "description": "Chrome extension for capturing images and videos using DevTools API",
  "scripts": {
    "dev": "npm-run-all --parallel dev:extension dev:proxy",
    "dev:extension": "pnpm --filter extension dev",
    "dev:proxy": "pnpm --filter proxy dev",
    "build": "pnpm --filter extension build",
    "zip": "pnpm --filter extension zip",
    "start": "pnpm --filter proxy start"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "keywords": [
    "chrome-extension",
    "image-capture",
    "video-capture",
    "devtools",
    "wxt"
  ],
  "author": "",
  "license": "MIT"
}