{
  "name": "vfs-service",
  "version": "1.0.0",
  "description": "Virtual File System Service with WebSocket API and HTTP file delivery for Chrome Extension",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "sharp": "^0.33.0",
    "ffmpeg-static": "^5.2.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/ws": "^8.5.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "vfs",
    "websocket",
    "http-api",
    "chrome-extension",
    "file-storage"
  ],
  "license": "MIT"
}
